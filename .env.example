# Author: Fabian Bitter (fabian@bitter.de)
# PixelLetter login, the e-mail address your PixelLetter account is registered with.
PIXELLETTER_EMAIL=
# PixelLetter password.
PIXELLETTER_PASSWORD=
# Endpoint of the HTTPS interface. Default: https://www.pixelletter.de/xml/index.php
PIXELLETTER_ENDPOINT=
# Accept the PixelLetter terms and conditions with every order. Must be true, the API rejects orders otherwise.
PIXELLETTER_ACCEPT_TERMS=true
# Waive the two week right of withdrawal so orders run immediately. false delays every order by two weeks.
PIXELLETTER_WAIVE_WITHDRAWAL_RIGHT=true
# Default dispatch centre: 1 = Munich (DE), 2 = Hausleiten near Vienna (AT), 3 = Hamburg (DE).
PIXELLETTER_DEFAULT_LOCATION=
# Default destination country as a two letter ISO code, for example DE.
PIXELLETTER_DEFAULT_DESTINATION=
# Force test mode for every order, whatever the tool call asks for. Useful while wiring things up.
PIXELLETTER_FORCE_TEST_MODE=false
# Request timeout in milliseconds. Default: 120000
PIXELLETTER_TIMEOUT_MS=
